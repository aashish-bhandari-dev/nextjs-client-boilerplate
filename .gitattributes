# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf diff=typescript
*.tsx text eol=lf diff=typescript
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.md text eol=lf
*.mdx text eol=lf
*.html text eol=lf diff=html
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.env* text eol=lf

# Configuration & dotfiles
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.prettierrc text eol=lf
.prettierignore text eol=lf
.nvmrc text eol=lf
.node-version text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
*.tgz binary

# Font files
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Lockfiles and generated files
package-lock.json text eol=lf -diff
pnpm-lock.yaml text eol=lf -diff
yarn.lock text eol=lf -diff
*.tsbuildinfo -diff -merge
